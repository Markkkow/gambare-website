# Blokir akses langsung ke file data dari browser.
# Data cuma boleh diakses lewat script PHP di folder /api,
# bukan dibuka langsung (karena berisi nama & no. WA customer).

# Apache 2.4+
<IfModule mod_authz_core.c>
    Require all denied
</IfModule>

# Fallback untuk Apache 2.2 (beberapa shared hosting lama)
<IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
</IfModule>
